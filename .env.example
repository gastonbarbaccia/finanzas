APP_NAME="Mis Finanzas"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
APP_LOCALE=es
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_CURRENCY_SYMBOL=$

# Solo producción (docker-compose.prod.yml)
APP_DOMAIN=localhost
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=finanzas
DB_USERNAME=finanzas
DB_PASSWORD=cambiar_esta_clave
DB_ROOT_PASSWORD=cambiar_esta_clave_root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync

# ---------- Inteligencia Artificial ----------
# Proveedor por defecto: gemini | openai | claude
AI_DEFAULT_PROVIDER=gemini
AI_TIMEOUT=60

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
